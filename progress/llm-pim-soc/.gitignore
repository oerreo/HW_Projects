# third-party downloads (fetched by data/scripts/fetch.sh, never committed)
data/third_party/
# build products and large vectors
model/build/
# job file used to run long commands
.job
# fpga: arrays derived from the model files (never committed) and host test outputs
fpga/sw/gen/
fpga/sw/test/build/
# sim: run directories, lock and transcripts (sim/tests, sim/common and sim/run.sh are sources;
# the workspace .gitignore ignores every **/sim/*/, re-included here)
sim/*/
!sim/tests/
!sim/common/
sim/.run.lock
sim/regression_*.log
# scratch outputs of job files
sim/.out
sim/.mut/
sim/.lint/
sim/*_mut/
sim/.job*
sim/.mut*/
sim/.lint*/
fpga/bw/build/
fpga/bw/test/build/
sim/.out*
sim/.env*
model/.job*
.j*
fpga/sys/test/build/
fpga/sys/test/.j*
